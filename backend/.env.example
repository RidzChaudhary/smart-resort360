# ─── Required for local development ───
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://resort_app:password@localhost:5432/resort360
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── JWT / Auth ───
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Production only (≥16 characters each) ───
# These are enforced at seed time when APP_ENV=production
DEMO_ACCOUNT_PASSWORD=
GUEST_DEMO_PASSWORD=
